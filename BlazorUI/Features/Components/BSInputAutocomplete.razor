    <div class="input-group" data-ref="@Refs["root"]">
        @if (InputType == InputType.InputGroup)
        {
            <span class="input-group-text" style="@($"width: {LabelWidth}px; {LabelStyle}")">@Label</span>
        }
        <InputText id="@Id"
                   class="form-control"
                   style="@InputStyle"
                   placeholder="@Placeholder"
                   autocomplete="off"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   aria-controls="@MenuId"
                   Value="@Value"
                   ValueChanged="ValueChanged"
                   ValueExpression="ValueExpression"
                   Disabled="@Disabled"
                   data-ref="@Refs["input"]" />
        <button type="button"
                class="btn btn-outline-secondary"
                tabindex="-1"
                title="@($"Show known {Label} values")"
                aria-label="@($"Show known {Label} values")"
                disabled="@(Disabled || Options.Count == 0)"
                data-ref="@Refs["toggle"]">
            <i class="bi bi-chevron-down"></i>
        </button>
