@using System.Linq.Expressions
@attribute [DiscoverCollocatedJS]
@inject JSElementReferenceScope Refs

@*
Sample usage:
<h4 class="mt-3">City</h4>

<div class="mb-3">
    <BSInputAutocomplete Id="acCityStd"
                         Class="mb-3"
                         Label="City"
                         InputType="InputType.Standard"
                         Options="@_cityOptions"
                         @bind-Value="_cityCode"
                         Placeholder="e.g. nyc" />
</div>

<div class="mb-3">
    <BSInputAutocomplete Id="acCityIG"
                         Class="mb-3"
                         Label="City"
                         InputType="InputType.InputGroup"
                         Options="@_cityOptions"
                         @bind-Value="_cityCode"
                         Placeholder="e.g. nyc" />
</div>

<p>Selected: @_cityCode</p>

@code {
    private string _cityCode = "";

    private readonly List<AutocompleteOption> _cityOptions =
    [
        new("nyc", "New York / nyc"),
        new("lax", "Los Angeles / lax"),
        new("chi", "Chicago / chi"),
        new("hou", "Houston / hou"),
        new("phx", "Phoenix / phx"),
        new("phl", "Philadelphia / phl"),
        new("sat", "San Antonio / sat"),
        new("san", "San Diego / san"),
        new("dfw", "Dallas / dfw"),
        new("sjc", "San Jose / sjc"),
        new("aus", "Austin / aus"),
        new("sea", "Seattle / sea"),
    ];
}
*@

<div class="@Class" style="@Style">
    @if (InputType == InputType.Standard && !string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="form-label mb-0" style="@($"width: {LabelWidth}px; {LabelStyle}")">@Label</label>
    }
