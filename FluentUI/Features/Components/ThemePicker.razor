@attribute [DiscoverCollocatedJS]
@inject JSElementReferenceScope Refs

@* FluentDialog and ThemeService need a circuit. The companion script calls Blazor.theme, the same functions IThemeService uses. *@
<div class="theme-picker">
    <button class="settings-trigger"
            type="button"
            title="Site settings"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="theme-settings"
            data-ref="@Refs["open"]">
        <FluentIcon Value="@(new Icons.Regular.Size20.Settings())" Color="Color.Custom" CustomColor="currentColor" />
    </button>

    <dialog id="theme-settings" class="settings-drawer" aria-labelledby="theme-settings-title" data-ref="@Refs["dialog"]">
        <div class="settings-panel">
            <div class="settings-panel-header">
                <FluentText Id="theme-settings-title" Weight="TextWeight.Semibold" Size="TextSize.Size500">Settings</FluentText>
                <button class="settings-close" type="button" title="Close" data-ref="@Refs["close"]">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Color="Color.Custom" CustomColor="currentColor" />
                </button>
            </div>

            <label class="settings-field">
                Appearance
                <span class="settings-select">
                    <select data-ref="@Refs["mode"]">
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                        <option value="system" selected>System</option>
                    </select>
                    <span class="expand-icon" aria-hidden="true">
                        <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" Color="Color.Custom" CustomColor="currentColor" />
                    </span>
                </span>
            </label>

            <div class="settings-field">
                <span id="theme-color-label">Color</span>
                <details class="settings-color-dropdown" data-ref="@Refs["colors"]">
                    <summary aria-haspopup="listbox" aria-labelledby="theme-color-label">
                        <span class="color-swatch" data-theme-swatch style="background:#0F6CBD"></span>
                        <span data-theme-color-label>Default</span>
                        <span class="expand-icon" aria-hidden="true">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronDown())" Color="Color.Custom" CustomColor="currentColor" />
                        </span>
                    </summary>
                    <div class="settings-color-list" role="listbox" aria-labelledby="theme-color-label">
                        @foreach (ThemeColor color in ThemeColor.All)
                        {
                            <button type="button"
                                    role="option"
                                    class="settings-color-option"
                                    data-theme-color="@color.Name"
                                    data-theme-hex="@(color.Hex ?? string.Empty)">
                                <span class="color-swatch" style="background:@color.Swatch"></span>@color.Name
                            </button>
                        }
                    </div>
                </details>
            </div>
        </div>
    </dialog>
</div>

<JS For="this" Key="ThemePicker" Args="[Refs]" />
