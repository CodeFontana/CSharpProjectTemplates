@attribute [DiscoverCollocatedJS]

@* FluentMenu wires its trigger in OnAfterRender, which static SSR does not run. *@
<nav class="fluent-header-nav" aria-label="Primary">
    <NavLink class="fluent-header-hover" href="/" Match="NavLinkMatch.All">Home</NavLink>

    <details class="fluent-header-menu" name="header-menu">
        <summary class="fluent-header-hover">Counters</summary>
        <div class="fluent-header-menu-panel">
            <NavLink href="/counter" Match="NavLinkMatch.All">Static Counter</NavLink>
            <NavLink href="/counter/interactive" Match="NavLinkMatch.All">Interactive Counter</NavLink>
        </div>
    </details>

    <details class="fluent-header-menu" name="header-menu">
        <summary class="fluent-header-hover">Lifecycle</summary>
        <div class="fluent-header-menu-panel">
            <NavLink href="/LifecycleDemo" Match="NavLinkMatch.All">Static Lifecycle</NavLink>
            <NavLink href="/LifecycleDemoAsync" Match="NavLinkMatch.All">Static Lifecycle with async</NavLink>
            <NavLink href="/LifecycleDemo/interactive" Match="NavLinkMatch.All">Interactive Lifecycle</NavLink>
            <NavLink href="/LifecycleDemoAsync/interactive" Match="NavLinkMatch.All">Interactive Lifecycle with async</NavLink>
        </div>
    </details>

    <NavLink class="fluent-header-hover" href="/weather">Weather</NavLink>

    <details class="fluent-header-menu" name="header-menu">
        <summary class="fluent-header-hover">Demos</summary>
        <div class="fluent-header-menu-panel">
            <NavLink href="/LifetimeDemo" Match="NavLinkMatch.All">Lifetime</NavLink>
            <NavLink href="/theme-demo" Match="NavLinkMatch.All">Theme</NavLink>
            <NavLink href="/form-demo" Match="NavLinkMatch.All">Form</NavLink>
        </div>
    </details>
</nav>

<JS For="this" Key="HeaderLinks" />
