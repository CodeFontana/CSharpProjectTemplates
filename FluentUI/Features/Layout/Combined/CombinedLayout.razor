@inherits LayoutComponentBase

<div class="combined-layout">
<FluentLayout Height="100%">
    <FluentLayoutItem Area="LayoutArea.Header" Sticky="true">
        <AppHeader ShowLinks="true" />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Width="260px">
        <AppNav />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Padding="@Padding.All4">
        @Body
    </FluentLayoutItem>
</FluentLayout>

<div class="nav-backdrop" data-nav-backdrop></div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
</div>
