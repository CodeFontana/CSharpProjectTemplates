@page "/weather"

<PageTitle>Weather</PageTitle>

<FluentText As="TextTag.H1" Size="TextSize.Size600">Weather</FluentText>

<FluentText>This component demonstrates showing data. Sorting, resizing, and selection stay off so the grid can render statically.</FluentText>

<FluentDataGrid Items="Forecasts" TGridItem="WeatherForecast">
        <PropertyColumn Title="Date" Property="@(forecast => forecast.Date)" Sortable="false" />
        <PropertyColumn Title="Temp. (C)" Property="@(forecast => forecast.TemperatureC)" Sortable="false" />
        <PropertyColumn Title="Temp. (F)" Property="@(forecast => forecast.TemperatureF)" Sortable="false" />
        <PropertyColumn Title="Summary" Property="@(forecast => forecast.Summary)" Sortable="false" />
    </FluentDataGrid>

@code {
    private IQueryable<WeatherForecast> Forecasts { get; } = CreateForecasts();

    private static IQueryable<WeatherForecast> CreateForecasts()
    {
        DateOnly startDate = DateOnly.FromDateTime(DateTime.Now);
        string[] summaries = ["Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching"];

        return Enumerable.Range(1, 50).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).AsQueryable();
    }

    private sealed class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
